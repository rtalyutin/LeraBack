DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Initial administrator, created only when no administrator accounts exist.
# Remove SALON_ADMIN_PASSWORD from hosting variables after the first successful login.
SALON_ADMIN_PASSWORD=REPLACE_WITH_YOUR_12_TO_256_CHARACTER_PASSWORD

# Docker defaults: prepared schema lera, port 8080, login salon_admin, policy from starter_data.json.
# No global CSRF key is required. The existing connection/password must be private.
# Optional overrides for existing installations; changing schema does not move data.
# DATABASE_SCHEMA=public
# PORT=8080
# SALON_ADMIN_USERNAME=salon_admin
# SALON_POLICY_JSON={"timezone":"Europe/Moscow","booking_horizon_days":30,"slot_step_minutes":30,"min_notice_minutes":120,"same_day_allowed":true,"buffer_minutes":0,"room_capacity":1,"allow_parallel_client_bookings":false,"cancel_cutoff_minutes":60,"reschedule_cutoff_minutes":60}
# SALON_CSRF_SECRET=YOUR_EXISTING_PRIVATE_32_BYTE_OR_LONGER_KEY
# Enable VK only after an authorized test-community connection:
# VK_GROUP_ID=
# VK_CALLBACK_SECRET=
# VK_CONFIRMATION_CODE=
# VK_COMMUNITY_TOKEN=
# VK_MASTER_PHOTO_IDS_JSON={}

# Legacy VK configuration belongs to this salon; previous installation is salon 1.
# VK_SALON_ID=1
# Multiple VK communities: private JSON array, do not combine with legacy VK variables.
# VK_INTEGRATIONS_JSON=[{"salon_id":1,"group_id":123,"secret":"REPLACE","confirmation_code":"REPLACE"}]

# Self-service VK wizard: one private host-wide encryption key, no per-salon variables.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it across deployments and backups. Replacing it does not re-encrypt stored keys.
# VK_TOKEN_ENCRYPTION_KEY=
